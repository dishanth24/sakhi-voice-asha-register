# ──────────────────────────────────────────────
# Sakhi Voice: ASHA Voice Register — Environment Variables
# Copy to .env and fill in values as needed
# ──────────────────────────────────────────────

# Speech provider: "browser" (default) | "gnani" | "text"
SPEECH_PROVIDER=browser

# Server
PORT=3001
HOST=0.0.0.0

# Encryption key for at-rest AES-256-GCM (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=replace_with_64_hex_chars_generated_above

# ──── Gnani (when SPEECH_PROVIDER=gnani) ────
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_WS_URL=wss://stt.gnani.ai/v3/stream
GNANI_TTS_WS_URL=wss://tts.gnani.ai/v3/stream

# ──── Optional LLM (improves extraction but not required) ────
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
